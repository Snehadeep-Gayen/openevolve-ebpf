 0);\n    return SK_PASS;\n}\n// EVOLVE-BLOCK-END\n\nchar _license[] SEC(\"license\") = \"GPL\";\n", "metrics": {"policy": "agent", "rates": [50000, 60000, 80000, 100000, 140000], "load_p99_curve": [[50000.0, 3.011], [60000.0, 4.059], [80000.0, 10.779], [100000.0, 4288.52], [140000.0, 6534.919]], "load_p99_stddev_curve": [[50000.0, 0.0], [60000.0, 0.0], [80000.0, 0.0], [100000.0, 0.0], [140000.0, 0.0]], "compile": 1.0, "load": 1.0, "combined_score": -25964.550000000003, "run_success": 1.0}, "log_metric": [], "parent_program": {"id": "31d5c930-2ac1-41da-8ac5-efacdee14056", "code": "/*\nPebble UDP reuseport selector — single-shot, randomized, division-free\n\nWhat changed and why\n- Drop multi-probe logic. Only the first bpf_sk_select_reuseport call is honored\n  by the kernel for reuseport selectors; extra calls waste cycles and our prior\n  deterministic probes created persistent hotspots.\n- Add verifier-approved per-packet randomness: mix reuse->hash with\n  bpf_get_prandom_u32() to decorrelate flows that would otherwise collide on\n  the same worker when some sockets are scan-heavy.\n- Keep constant-time mapping into [0, active):\n  * Power-of-two active: slot = hash & (active - 1)\n  * Otherwise: slot = ((hash * active) >> 32) using 64-bit multiply-high\n- Clamp active to map capacity (128) and make exactly one helper call.\n\nExpected effect\n- Lower instruction count and branching per packet improves p99.\n- Randomized spreading helps avoid long queues and reduces tail latency under\n  transient congestion without loops or retries.\n\nVerifier compliance\n- One bpf_sk_select_reuseport call, no loops, tiny stack, only fields from\n  sk_reuseport_md plus pinned maps. GPL license and map names unchanged.\n*/\n//go:build ignore\n\n#include <linux/bpf.h>\n#include <bpf/bpf_helpers.h>\n\nstruct {\n    __uint(type, BPF_MAP_TYPE_REUSEPORT_SOCKARRAY);\n    __uint(max_entries, 128);\n    __type(key, __u32);\n    __type(value, __u32);\n    __uint(pinning, LIBBPF_PIN_BY_NAME);\n} pebble_udp_targets SEC(\".maps\");\n\nstruct agent_state {\n    __u32 active;\n    __u32 pad;\n};\n\nstruct {\n    __uint(type, BPF_MAP_TYPE_ARRAY);\n    __uint(max_entries, 1);\n    __type(key, __u32);\n    __type(value, struct agent_state);\n    __uint(pinning, LIBBPF_PIN_BY_NAME);\n} pebble_agent_state SEC(\".maps\");\n\n// EVOLVE-BLOCK-START\n\nSEC(\"sk_reuseport/selector\")\nenum sk_action agent_udp_selector(struct sk_reuseport_md *reuse)\n{\n    __u32 key = 0;\n    struct agent_state *state = bpf_map_lookup_elem(&pebble_agent_state, &key);\n    if (!state)\n        return SK_PASS;\n\n    __u32 active = state->active;\n    if (active == 0)\n        return SK_PASS;\n\n    // Clamp to map capacity.\n    if (active > 128)\n        active = 128;\n\n    // Mix per-packet randomness to decorrelate bursts and avoid hotspots.\n    __u32 h = reuse->hash ^ bpf_get_prandom_u32();\n\n    // Division-free slot computation.\n    __u32 slot;\n    if ((active & (active - 1)) == 0)\n        slot = h & (active - 1);\n    else\n        slot = ((__u64)h * (__u64)active) >> 32;\n\n    // Single attempt; kernel falls back if this slot is empty.\n    bpf_sk_select_reuseport(reuse, &pebble_udp_targets, &slot, 0);\n    return SK_PASS;\n}\n// EVOLVE-BLOCK-END\n\nchar _license[] SEC(\"license\") = \"GPL\";\n", "language": "cpp", "parent_id": "5f581f0a-7173-48f3-aac2-5827cde6b79d", "generation": 3, "timestamp": 1763047864.1877315, "iteration_found": 6, "metrics": {"policy": "agent", "rates": [50000, 60000, 80000, 100000, 140000], "load_p99_curve": [[50000.0, 2.344], [60000.0, 2.622], [80000.0, 3.579], [100000.0, 4.637], [140000.0, 17.216]], "load_p99_stddev_curve": [[50000.0, 0.0], [60000.0, 0.0], [80000.0, 0.0], [100000.0, 0.0], [140000.0, 0.0]], "compile": 1.0, "load": 1.0, "combined_score": -60.606, "run_success": 1.0}, "complexity": 0.0, "diversity": 0.0, "metadata": {"changes": "Change 1: Replace 28 lines with 24 lines\nChange 2: Replace 50 lines with 30 lines", "parent_metr