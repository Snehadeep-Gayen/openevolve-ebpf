ke exactly one bpf_sk_select_reuseport call. If the slot is empty, we let\n  the kernel fall back to its default selection, preserving correctness.\n\nWhy this should improve performance\n- Eliminates the heavy unrolled loop and multiple conditional branches,\n  reducing per-packet instruction count and branch mispredicts — key for p99.\n- Avoids modulo by non-constant (a costly div in eBPF), replacing it with\n  a fast bit-mask or mul-high.\n- Keeps flow stickiness by relying on reuse->hash, improving fairness and\n  predictability at higher rates, reducing jitter and tail latency.\n\nVerifier compliance\n- No unbounded loops; minimal stack use; one helper call; only uses fields\n  available in sk_reuseport_md. GPL license and map names/types unchanged.\n*/\n//go:build ignore\n\n#include <linux/bpf.h>\n#include <bpf/bpf_helpers.h>\n\nstruct {\n    __uint(type, BPF_MAP_TYPE_REUSEPORT_SOCKARRAY);\n    __uint(max_entries, 128);\n    __type(key, __u32);\n    __type(value, __u32);\n    __uint(pinning, LIBBPF_PIN_BY_NAME);\n} pebble_udp_targets SEC(\".maps\");\n\nstruct agent_state {\n    __u32 active;\n    __u32 pad;\n};\n\nstruct {\n    __uint(type, BPF_MAP_TYPE_ARRAY);\n    __uint(max_entries, 1);\n    __type(key, __u32);\n    __type(value, struct agent_state);\n    __uint(pinning, LIBBPF_PIN_BY_NAME);\n} pebble_agent_state SEC(\".maps\");\n\n// EVOLVE-BLOCK-START\n\nSEC(\"sk_reuseport/selector\")\nenum sk_action agent_udp_selector(struct sk_reuseport_md *reuse)\n{\n    __u32 key = 0;\n    struct agent_state *state = bpf_map_lookup_elem(&pebble_agent_state, &key);\n    if (!state)\n        return SK_PASS;\n\n    __u32 active = state->active;\n    if (active == 0)\n        return SK_PASS;\n\n    // Clamp to map capacity for safety.\n    if (active > 128)\n        active = 128;\n\n    // Mix verifier-approved randomness to decorrelate bursts between workers.\n    // This reduces persistent hot spots when a worker is momentarily scan-heavy.\n    __u32 h = reuse->hash;\n 